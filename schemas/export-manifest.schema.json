{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wyattowalsh/cwa/schemas/export-manifest.schema.json",
  "title": "CWA visible-thread export manifest",
  "description": "Provenance for a locally generated ZIP of the currently visible ChatGPT thread. Does not describe private provider conversation JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "product",
    "source",
    "exportedAt",
    "formats",
    "files",
    "limitations",
    "media"
  ],
  "properties": {
    "schema": {
      "const": "cwa.export-manifest.v1"
    },
    "product": {
      "const": "cwa"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "url"],
      "properties": {
        "authority": {
          "enum": ["observed-ui", "local-cwa"]
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "exportedAt": {
      "type": "string"
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["md", "zip", "clipboard"]
      },
      "description": "Local export surfaces only. The value json is forbidden because it implied a conversation payload."
    },
    "files": {
      "type": "array",
      "allOf": [
        {
          "contains": {
            "const": "chat.md"
          }
        },
        {
          "contains": {
            "const": "MANIFEST.md"
          }
        }
      ],
      "items": {
        "type": "string",
        "not": {
          "pattern": "(^|/)conversation\\.json$"
        }
      },
      "description": "Archive entry paths. chat.md and MANIFEST.md are required; any path with the basename conversation.json is forbidden."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "detail"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "detected": { "type": "boolean" }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow"],
      "properties": {
        "included": { "type": "integer", "minimum": 0 },
        "workflow": {
          "description": "Mounted under main, excluding nav, CWA chrome, and CSS-hidden ancestors. This does not mean viewport visibility.",
          "enum": ["visible-dom"]
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "reason"],
            "properties": {
              "url": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "reason"],
            "properties": {
              "url": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "officialExport": {
      "type": "string"
    }
  }
}
